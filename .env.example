# Copy this file to `.env` and fill in real values for local development.
# Railway projects supply these via the dashboard (Service → Variables).

# Public site URL used for canonical links and OG images.
PUBLIC_SITE_URL="https://www.hubaajto.hu"

# Where /api/lead drops its submissions. Defaults to info@szerx.hu when unset.
LEAD_DESTINATION_EMAIL="info@szerx.hu"

# Optional — Resend API key for transactional email delivery.
# When unset the lead endpoint logs to stdout only (see TODO in src/pages/api/lead.ts).
# RESEND_API_KEY=""

# Optional — port override. Railway sets this automatically; locally defaults to 8080.
# PORT="8080"

# ─── Huba, the site assistant (src/lib/huba, HUBA.md) ───────────────
# Huba appears only when an Anthropic key is set.
# ANTHROPIC_API_KEY=""
# HUBA_MODEL="claude-haiku-5-5"      # same model as Datolya
# HUBA_EFFORT="low"
# Password that switches a conversation to owner ("megrendelői") mode.
# HUBA_OWNER_PASSWORD=""
# Alfred's token for GET /api/huba/inbox (alfred/.env: HUBA_INBOX_TOKEN).
# HUBA_INBOX_TOKEN=""
# Where conversations are kept; on Railway a volume mounted at /app/data.
# HUBA_DATA_DIR="data/huba"

# Outgoing mail for Huba's orders (any SMTP mailbox).
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Huba ajtó weboldal <web@hubaajto.hu>"
# HUBA_ORDER_TO="info@szerx.hu"      # defaults to LEAD_DESTINATION_EMAIL
