---
interface Props {
  variant?: "wordmark" | "monogram";
  class?: string;
  size?: "sm" | "md" | "lg";
}

const { variant = "wordmark", class: className = "", size = "md" } = Astro.props;

const src = variant === "monogram"
  ? "/assets/brand/monogram.png"
  : "/assets/brand/wordmark-primary.png";

const widths = {
  sm: variant === "monogram" ? 40 : 200,
  md: variant === "monogram" ? 56 : 260,
  lg: variant === "monogram" ? 80 : 360,
};

// wordmark aspect ratio: 787 / 346 ≈ 2.27 (width / height)
const wordmarkRatio = 2.27;
const ratio = variant === "monogram" ? 1 : 1 / wordmarkRatio;
---
<a href="/" class={`logo-link inline-flex items-center ${className}`} data-variant={variant} data-size={size} aria-label="Huba ajtó — kezdőlap">
  <img
    src={src}
    alt="Huba ajtó"
    width={widths[size]}
    height={Math.round(widths[size] * ratio)}
    style="width: var(--logo-w, var(--logo-default)); height: auto;"
    decoding="async"
    fetchpriority={variant === "monogram" ? "low" : "high"}
  />
</a>

<style>
  /* Default widths per variant/size. An ancestor may set --logo-w to override (e.g. the header at tight widths). */
  .logo-link[data-variant="wordmark"][data-size="sm"] { --logo-default: 200px; }
  .logo-link[data-variant="wordmark"][data-size="md"] { --logo-default: 260px; }
  .logo-link[data-variant="wordmark"][data-size="lg"] { --logo-default: 360px; }
  .logo-link[data-variant="monogram"][data-size="sm"] { --logo-default: 40px; }
  .logo-link[data-variant="monogram"][data-size="md"] { --logo-default: 56px; }
  .logo-link[data-variant="monogram"][data-size="lg"] { --logo-default: 80px; }
</style>
