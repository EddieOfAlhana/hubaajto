---
interface Pair {
  before: string;
  after: string;
  beforeAlt?: string;
  afterAlt?: string;
  caption?: string;
  label?: string;
}
interface Props {
  pairs: Pair[];
  initial?: number;
}
const { pairs, initial = 50 } = Astro.props;
const id = `bag-${Math.random().toString(36).slice(2, 8)}`;
const first = pairs[0];
---

<div class="bag-wrap reveal" data-bag data-bag-pairs={JSON.stringify(pairs)} id={id}>
  <div class="ba-frame" data-ba-frame style={`--ba-pos: ${initial}%`}>
    <img class="ba-after" data-bag-after src={first.after} alt={first.afterAlt ?? "Új Huba ajtó"} loading="lazy" />
    <div class="ba-before-clip" aria-hidden="true">
      <img class="ba-before" data-bag-before src={first.before} alt={first.beforeAlt ?? "Régi ajtó"} loading="lazy" />
    </div>
    <input class="ba-range" type="range" min="0" max="100" value={initial} aria-label="Előtte / utána csúszka" />
    <span class="ba-divider" aria-hidden="true">
      <span class="ba-divider-grip" aria-hidden="true"></span>
    </span>
    <span class="ba-label ba-label-before">Előtte</span>
    <span class="ba-label ba-label-after">Utána</span>
  </div>
  {first.caption && <p class="bag-caption" data-bag-caption>{first.caption}</p>}

  <div class="bag-thumbs">
    {pairs.map((p, i) => (
      <button
        type="button"
        class="bag-thumb"
        data-bag-thumb
        data-index={i}
        aria-current={i === 0 ? "true" : "false"}
        aria-label={p.label ? `${p.label} megtekintése` : `${i + 1}. előtte/utána pár megtekintése`}
      >
        <img src={p.after} alt="" loading="lazy" />
        {p.label && <span class="bag-thumb-label">{p.label}</span>}
      </button>
    ))}
  </div>
</div>

<style>
  .bag-wrap { margin: 0; }
  .ba-frame {
    position: relative; aspect-ratio: 3/4; max-height: 640px; overflow: hidden;
    background: var(--color-cream);
  }
  .ba-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba-before-clip { position: absolute; inset: 0; width: var(--ba-pos); overflow: hidden; }
  .ba-before-clip img { width: calc(100% * (100 / var(--ba-pos-num, 50))); max-width: none; }
  .ba-range {
    position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; z-index: 3;
  }
  .ba-divider {
    position: absolute; top: 0; bottom: 0; left: var(--ba-pos); width: 2px;
    background: var(--color-paper); transform: translateX(-1px); pointer-events: none;
  }
  .ba-divider-grip {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 40px; height: 40px; background: var(--color-paper); color: var(--color-ink);
    border-radius: 999px; display: grid; place-items: center;
    box-shadow: 0 6px 20px rgba(14,15,17,0.25);
  }
  .ba-divider-grip::before { content: "⇆"; font-size: 1rem; }

  .ba-label {
    position: absolute; top: 1rem; padding: 0.4rem 0.7rem; background: rgba(14,15,17,0.7);
    color: var(--color-paper); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase;
    pointer-events: none;
  }
  .ba-label-before { left: 1rem; }
  .ba-label-after { right: 1rem; }

  .bag-caption { margin: 0.75rem 0 0; font-size: 0.85rem; color: var(--color-stone); letter-spacing: 0.02em; min-height: 1.2em; }

  .bag-thumbs {
    display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.25rem;
  }
  .bag-thumb {
    position: relative; flex: 0 0 72px; aspect-ratio: 3/4; overflow: hidden;
    border: 2px solid transparent; padding: 0; cursor: pointer; background: var(--color-cream);
    opacity: 0.6; transition: opacity var(--dur) var(--ease-out-soft), border-color var(--dur) var(--ease-out-soft);
  }
  .bag-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bag-thumb:hover { opacity: 0.85; }
  .bag-thumb[aria-current="true"] { opacity: 1; border-color: var(--color-brass); }
  .bag-thumb-label {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 0.25rem 0.35rem;
    background: rgba(14,15,17,0.7); color: var(--color-paper); font-size: 0.62rem;
    letter-spacing: 0.02em; line-height: 1.2; text-align: center;
  }
</style>

<script>
  interface PairData {
    before: string;
    after: string;
    beforeAlt?: string;
    afterAlt?: string;
    caption?: string;
    label?: string;
  }

  function initBeforeAfterGalleries() {
    document.querySelectorAll<HTMLElement>("[data-bag]").forEach((wrap) => {
      if (wrap.dataset.bagInit) return;
      wrap.dataset.bagInit = "true";

      const frame = wrap.querySelector<HTMLElement>("[data-ba-frame]");
      const range = wrap.querySelector<HTMLInputElement>(".ba-range");
      const afterImg = wrap.querySelector<HTMLImageElement>("[data-bag-after]");
      const beforeImg = wrap.querySelector<HTMLImageElement>("[data-bag-before]");
      const captionEl = wrap.querySelector<HTMLElement>("[data-bag-caption]");
      const thumbs = Array.from(wrap.querySelectorAll<HTMLButtonElement>("[data-bag-thumb]"));
      if (!frame || !range || !afterImg || !beforeImg) return;

      const updateSlider = () => {
        frame.style.setProperty("--ba-pos", `${range.value}%`);
        frame.style.setProperty("--ba-pos-num", range.value);
      };
      range.addEventListener("input", updateSlider);
      updateSlider();

      const pairs: PairData[] = JSON.parse(wrap.dataset.bagPairs || "[]");

      const activate = (index: number) => {
        const pair = pairs[index];
        if (!pair) return;
        afterImg.src = pair.after;
        afterImg.alt = pair.afterAlt ?? "Új Huba ajtó";
        beforeImg.src = pair.before;
        beforeImg.alt = pair.beforeAlt ?? "Régi ajtó";
        if (captionEl) captionEl.textContent = pair.caption ?? "";
        range.value = "50";
        updateSlider();
        thumbs.forEach((t, i) => t.setAttribute("aria-current", i === index ? "true" : "false"));
      };

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => activate(Number(thumb.dataset.index)));
      });
    });
  }

  initBeforeAfterGalleries();
  document.addEventListener("astro:page-load", initBeforeAfterGalleries);
</script>
