---
/**
 * Consent banner on every page (BaseLayout), persisted across client-side navigation.
 * Google Analytics 4 loads only once the visitor has accepted; rejecting later turns it off
 * and clears its cookies.
 */
import { SITE } from "../data/site";
---
<div class="cookie" data-cookie data-ga-id={SITE.gaMeasurementId} transition:persist="cookie-banner" role="dialog" aria-modal="false" aria-label="Süti beállítások">
  <div class="cookie-card">
    <h2 class="cookie-title">Süti beállítások</h2>
    <p class="cookie-body">
      Honlapunk a szükséges sütiken túl statisztikai sütiket csak az Ön hozzájárulásával használ.
      Az „Elutasítom" gombbal csak a működéshez kötelező sütik maradnak aktívak. Részletek az
      <a href="/suti">Süti tájékoztatóban</a> és az <a href="/adatvedelem">Adatkezelési tájékoztatóban</a>.
    </p>
    <div class="cookie-actions">
      <button class="btn btn-ghost" data-cookie-action="reject">Elutasítom</button>
      <button class="btn btn-primary" data-cookie-action="accept">Elfogadom</button>
    </div>
  </div>
</div>

<style>
  .cookie {
    position: fixed; bottom: calc(var(--mobile-cta-h) + 0.75rem); left: 1.25rem; right: 1.25rem; z-index: 60;
    display: none;
  }
  .cookie.is-shown { display: block; animation: rise 0.6s var(--ease-out-soft); }
  /* Huba's launcher shares this corner; it steps aside until the visitor has chosen. */
  :global(body:has(.cookie.is-shown) .huba-launch) { display: none; }
  @keyframes rise { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  @media (min-width: 640px) { .cookie { left: auto; right: 1.5rem; max-width: 28rem; } }
  @media (min-width: 720px) { .cookie { bottom: 1.25rem; } }
  .cookie-card {
    background: var(--color-paper); border: 1px solid rgba(14,15,17,0.1);
    padding: 1.25rem 1.25rem 1rem; box-shadow: var(--shadow-card);
  }
  .cookie-title { font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 0.5rem; }
  .cookie-body { font-size: 0.85rem; line-height: 1.55; color: var(--color-charcoal); }
  .cookie-body a { color: var(--color-brass-deep); text-decoration: underline; text-underline-offset: 3px; }
  .cookie-actions { display: flex; gap: 0.5rem; margin-top: 1rem; justify-content: flex-end; }
</style>

<script>
  const KEY = "huba-cookie-consent";
  const el = document.querySelector<HTMLElement>("[data-cookie]");
  const gaId = el?.dataset.gaId;

  type Gtag = (...args: unknown[]) => void;
  const w = window as unknown as { dataLayer: unknown[]; gtag?: Gtag };

  const storedChoice = () => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? "null")?.choice as string | undefined; }
    catch { return undefined; }
  };

  const loadAnalytics = () => {
    if (!gaId) return;
    if (w.gtag) { w.gtag("consent", "update", { analytics_storage: "granted" }); return; }
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () { w.dataLayer.push(arguments); };
    w.gtag("consent", "default", {
      analytics_storage: "granted", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied",
    });
    w.gtag("js", new Date());
    w.gtag("config", gaId);
    const s = document.createElement("script");
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(s);
  };

  const stopAnalytics = () => {
    w.gtag?.("consent", "update", { analytics_storage: "denied" });
    const host = location.hostname.replace(/^www\./, "");
    document.cookie.split(";").map(c => c.split("=")[0].trim()).filter(n => n.startsWith("_ga")).forEach(n => {
      for (const domain of ["", `; domain=${host}`, `; domain=.${host}`]) {
        document.cookie = `${n}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${domain}`;
      }
    });
  };

  const choice = storedChoice();
  if (!choice) el?.classList.add("is-shown");
  if (choice === "accept") loadAnalytics();

  el?.querySelectorAll<HTMLButtonElement>("[data-cookie-action]").forEach(btn => {
    btn.addEventListener("click", () => {
      const choice = btn.dataset.cookieAction;
      localStorage.setItem(KEY, JSON.stringify({ choice, at: new Date().toISOString() }));
      el.classList.remove("is-shown");
      if (choice === "accept") {
        loadAnalytics();
        document.dispatchEvent(new CustomEvent("huba:consent-granted"));
      } else {
        stopAnalytics();
      }
    });
  });

  // Delegated, so footer buttons swapped in by client-side navigation keep working.
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement | null)?.closest("[data-cookie-reopen]")) el?.classList.add("is-shown");
  });
</script>
