---
/**
 * Huba — the site's assistant (src/lib/huba). A floating button on every page; the panel
 * survives page navigation (transition:persist). The conversation id and token live in
 * localStorage, so a reload restores the transcript until the conversation is closed.
 */
import { CONTACT } from "../data/site";
---

<div id="huba" class="huba" transition:persist="huba" data-phone={CONTACT.phonePrimary}>
  <button type="button" class="huba-launch" aria-expanded="false" aria-controls="huba-panel">
    <svg class="huba-door" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M8 29V9a8 8 0 0 1 16 0v20" fill="none" stroke="currentColor" stroke-width="1.8" />
      <path d="M5 29h22" stroke="currentColor" stroke-width="1.8" />
      <rect x="11.5" y="11" width="9" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="1.2" />
      <rect x="11.5" y="19.5" width="9" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="1.2" />
      <circle cx="21.6" cy="18.2" r="1.2" fill="currentColor" />
    </svg>
    <span class="huba-launch-label">Kérdezze Hubát</span>
  </button>

  <section id="huba-panel" class="huba-panel" role="dialog" aria-label="Huba, a Huba ajtó asszisztense" hidden>
    <header class="huba-head">
      <div class="huba-id">
        <span class="huba-avatar" aria-hidden="true">
          <svg viewBox="0 0 32 32"><path d="M8 29V9a8 8 0 0 1 16 0v20" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="21.4" cy="18.2" r="1.4" fill="currentColor" /></svg>
        </span>
        <div>
          <p class="huba-name">Huba</p>
          <p class="huba-sub">a Huba ajtó asszisztense</p>
        </div>
        <span class="huba-badge" hidden>megrendelői mód</span>
      </div>
      <div class="huba-actions">
        <button type="button" class="huba-done" hidden title="Beszélgetés lezárása">Kész</button>
        <button type="button" class="huba-x" aria-label="Bezárás">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" /></svg>
        </button>
      </div>
    </header>

    <div class="huba-log" aria-live="polite"></div>

    <div class="huba-files" hidden></div>
    <p class="huba-error" role="alert" hidden></p>

    <form class="huba-form">
      <label class="huba-attach" title="Kép vagy PDF csatolása">
        <input type="file" accept="image/*,application/pdf" multiple hidden />
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5l-7.8 7.8a5 5 0 0 1-7.1-7.1l8.5-8.5a3.3 3.3 0 0 1 4.7 4.7l-8.5 8.5a1.7 1.7 0 0 1-2.4-2.4l7.8-7.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        <span class="sr-only">Fájl csatolása</span>
      </label>
      <textarea rows="1" placeholder="Írjon Hubának…" aria-label="Üzenet Hubának" maxlength="4000"></textarea>
      <button type="submit" class="huba-send" aria-label="Küldés">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </form>
    <p class="huba-note">
      Huba mesterséges intelligencia, tévedhet. A beszélgetést munkatársaink elolvashatják.
      <a href="/adatvedelem">Adatvédelem</a>
    </p>
  </section>
</div>

<script>
  type Msg = { role: "user" | "assistant"; content: string; attachments?: string[] };
  type Session = { id: string; token: string };

  const KEY = "huba.conversation";
  const MAX_FILES = 5;
  const root = document.getElementById("huba")!;
  const launch = root.querySelector<HTMLButtonElement>(".huba-launch")!;
  const panel = root.querySelector<HTMLElement>(".huba-panel")!;
  const log = root.querySelector<HTMLElement>(".huba-log")!;
  const form = root.querySelector<HTMLFormElement>(".huba-form")!;
  const input = root.querySelector<HTMLTextAreaElement>("textarea")!;
  const fileInput = root.querySelector<HTMLInputElement>('input[type="file"]')!;
  const filesBox = root.querySelector<HTMLElement>(".huba-files")!;
  const errorBox = root.querySelector<HTMLElement>(".huba-error")!;
  const doneBtn = root.querySelector<HTMLButtonElement>(".huba-done")!;
  const badge = root.querySelector<HTMLElement>(".huba-badge")!;
  const sendBtn = root.querySelector<HTMLButtonElement>(".huba-send")!;

  let session: Session | null = null;
  let pending: File[] = [];
  let busy = false;
  let restored = false;

  const store = {
    get(): Session | null {
      try { return JSON.parse(localStorage.getItem(KEY) || "null"); } catch { return null; }
    },
    set(s: Session | null) {
      try { s ? localStorage.setItem(KEY, JSON.stringify(s)) : localStorage.removeItem(KEY); } catch { /* private mode */ }
    },
  };

  // ── Rendering ────────────────────────────────────────────────
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  function inline(s: string): string {
    return esc(s)
      .replace(/!\[([^\]]*)\]\(((?:https:\/\/www\.hubaajto\.hu)?\/assets\/[^)\s]+\.(?:png|jpe?g|webp|gif))\)/gi, (_, alt, src) =>
        `<a class="huba-img" href="${src}" target="_blank" rel="noopener"><img src="${src}" alt="${alt}" loading="lazy"></a>`)
      .replace(/\[([^\]]+)\]\(((?:https?:\/\/|\/|tel:|mailto:)[^)\s]*)\)/g, (_, t, href) => {
        const external = /^https?:/.test(href) && !href.includes("hubaajto.hu");
        return `<a href="${href}"${external ? ' target="_blank" rel="noopener"' : ""}>${t}</a>`;
      })
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>");
  }

  function markdown(md: string): string {
    const out: string[] = [];
    let list: "ul" | "ol" | null = null;
    const closeList = () => { if (list) { out.push(`</${list}>`); list = null; } };
    for (const raw of md.split("\n")) {
      const line = raw.trimEnd();
      const ul = line.match(/^\s*[-•*]\s+(.*)/);
      const ol = line.match(/^\s*\d+[.)]\s+(.*)/);
      if (ul || ol) {
        const kind = ul ? "ul" : "ol";
        if (list !== kind) { closeList(); out.push(`<${kind}>`); list = kind; }
        out.push(`<li>${inline((ul || ol)![1])}</li>`);
        continue;
      }
      closeList();
      if (!line.trim()) continue;
      const h = line.match(/^#{1,4}\s+(.*)/);
      out.push(h ? `<p><strong>${inline(h[1])}</strong></p>` : `<p>${inline(line)}</p>`);
    }
    closeList();
    return out.join("");
  }

  function bubble(m: Msg) {
    const el = document.createElement("div");
    el.className = `huba-msg huba-${m.role}`;
    el.innerHTML = m.role === "assistant" ? markdown(m.content) : `<p>${esc(m.content).replace(/\n/g, "<br>")}</p>`;
    if (m.attachments?.length) {
      const a = document.createElement("p");
      a.className = "huba-att";
      a.textContent = "📎 " + m.attachments.join(", ");
      el.appendChild(a);
    }
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  function intro() {
    log.innerHTML = "";
    bubble({
      role: "assistant",
      content:
        "Jó napot kívánok! **Huba** vagyok, a Huba ajtó asszisztense.\n\n" +
        "Kérdezzen bátran az ajtóinkról, az árakról vagy a műemléki engedélyezésről — vagy kérjen **ingyenes felmérést**, és továbbítom a műhelynek. " +
        "Fotót is küldhet a mostani ajtajáról a 📎 gombbal.",
    });
    chips(["Mennyibe kerül egy biztonsági ajtó?", "Ingyenes felmérést kérek", "Műemléki házban lakom"]);
  }

  function chips(questions: string[]) {
    root.querySelector(".huba-chips")?.remove();
    const box = document.createElement("div");
    box.className = "huba-chips";
    for (const q of questions) {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = q;
      b.addEventListener("click", () => { box.remove(); send(q); });
      box.appendChild(b);
    }
    log.appendChild(box);
    log.scrollTop = log.scrollHeight;
  }

  // Owner mode: what Gabi can ask for — the site, and the marketing plan Huba talks through.
  const OWNER_CHIPS = ["Hogyan lehet több megrendelés?", "Mi készült el eddig a marketingből?", "Mit kell nekem megcsinálnom?", "Módosítást kérek az oldalon"];
  let mode = "customer";

  function setMode(next: string) {
    badge.hidden = next !== "owner";
    if (next === "owner" && mode !== "owner") chips(OWNER_CHIPS);
    mode = next;
  }

  function showError(text: string | null) {
    errorBox.hidden = !text;
    errorBox.textContent = text || "";
  }

  function renderFiles() {
    filesBox.hidden = pending.length === 0;
    filesBox.innerHTML = "";
    pending.forEach((f, i) => {
      const chip = document.createElement("span");
      chip.className = "huba-file";
      chip.textContent = f.name;
      const x = document.createElement("button");
      x.type = "button";
      x.setAttribute("aria-label", `${f.name} eltávolítása`);
      x.textContent = "×";
      x.addEventListener("click", () => { pending.splice(i, 1); renderFiles(); });
      chip.appendChild(x);
      filesBox.appendChild(chip);
    });
  }

  // ── Files: phone photos are shrunk before upload ─────────────
  async function shrink(file: File): Promise<File> {
    if (!/^image\/(jpeg|png|webp)$/.test(file.type) || file.size < 1_500_000) return file;
    try {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, 2000 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement("canvas");
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext("2d")!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, "image/jpeg", 0.85));
      if (!blob) return file;
      return new File([blob], file.name.replace(/\.\w+$/, "") + ".jpg", { type: "image/jpeg" });
    } catch {
      return file;
    }
  }

  async function addFiles(list: FileList | File[]) {
    for (const f of Array.from(list)) {
      if (pending.length >= MAX_FILES) { showError(`Egyszerre legfeljebb ${MAX_FILES} fájl küldhető.`); break; }
      if (!/^image\//.test(f.type) && f.type !== "application/pdf") { showError(`${f.name}: csak kép vagy PDF küldhető.`); continue; }
      pending.push(await shrink(f));
    }
    renderFiles();
  }

  // ── Server ───────────────────────────────────────────────────
  async function api(path: string, init: RequestInit = {}) {
    const headers = new Headers(init.headers);
    if (session) headers.set("X-Huba-Token", session.token);
    const res = await fetch(`/api/huba${path}`, { ...init, headers });
    const body = await res.json().catch(() => ({ ok: false, error: "Váratlan válasz a szervertől." }));
    if (!res.ok || body.ok === false) throw Object.assign(new Error(body.error || "Hiba történt."), { status: res.status });
    return body;
  }

  async function ensureSession() {
    if (session) return session;
    const body = await api("/conversations", { method: "POST" });
    session = { id: body.conversation.id, token: body.token };
    store.set(session);
    doneBtn.hidden = false;
    return session;
  }

  async function restore() {
    restored = true;
    const saved = store.get();
    if (!saved) return intro();
    session = saved;
    try {
      const body = await api(`/conversations/${saved.id}`);
      if (body.conversation.status !== "open") throw new Error("closed");
      log.innerHTML = "";
      for (const m of body.conversation.messages as Msg[]) bubble(m);
      if (!body.conversation.messages.length) intro();
      setMode(body.conversation.mode);
      doneBtn.hidden = false;
    } catch {
      session = null;
      store.set(null);
      intro();
    }
  }

  async function send(text: string) {
    if (busy) return;
    const files = pending;
    if (!text.trim() && !files.length) return;
    busy = true;
    sendBtn.disabled = true;
    showError(null);
    root.querySelector(".huba-chips")?.remove();
    bubble({ role: "user", content: text.trim() || "(csatolmány)", attachments: files.map((f) => f.name) });
    pending = [];
    renderFiles();
    input.value = "";
    autosize();
    const thinking = document.createElement("div");
    thinking.className = "huba-msg huba-assistant huba-thinking";
    thinking.innerHTML = "<p><span></span><span></span><span></span></p>";
    log.appendChild(thinking);
    log.scrollTop = log.scrollHeight;
    try {
      const s = await ensureSession();
      const data = new FormData();
      data.set("text", text);
      data.set("pagePath", location.pathname);
      data.set("pageTitle", document.title);
      for (const f of files) data.append("files", f, f.name);
      const body = await api(`/conversations/${s.id}/messages`, { method: "POST", body: data });
      thinking.remove();
      bubble({ role: "assistant", content: body.reply });
      setMode(body.mode);
    } catch (e) {
      thinking.remove();
      const err = e as Error & { status?: number };
      if (err.status === 404 || err.status === 409) { session = null; store.set(null); doneBtn.hidden = true; }
      showError(err.message || "Nem sikerült elküldeni. Próbálja újra.");
      if (!input.value) input.value = text;
      pending = files;
      renderFiles();
    } finally {
      busy = false;
      sendBtn.disabled = false;
      input.focus();
    }
  }

  async function finish() {
    if (!session || busy) return;
    const s = session;
    session = null;
    store.set(null);
    doneBtn.hidden = true;
    setMode("customer");
    api(`/conversations/${s.id}/close`, { method: "POST", headers: { "X-Huba-Token": s.token } }).catch(() => undefined);
    intro();
    bubble({ role: "assistant", content: "Köszönöm a beszélgetést! Ha újabb kérdése lesz, itt vagyok." });
  }

  // ── Wiring ───────────────────────────────────────────────────
  function open(state: boolean) {
    panel.hidden = !state;
    root.classList.toggle("is-open", state);
    launch.setAttribute("aria-expanded", String(state));
    document.documentElement.classList.toggle("huba-lock", state && matchMedia("(max-width: 639px)").matches);
    if (state) {
      if (!restored) restore();
      setTimeout(() => input.focus(), 50);
    }
  }

  function autosize() {
    input.style.height = "auto";
    input.style.height = Math.min(input.scrollHeight, 140) + "px";
  }

  launch.addEventListener("click", () => open(panel.hidden));
  root.querySelector(".huba-x")!.addEventListener("click", () => open(false));
  doneBtn.addEventListener("click", finish);
  form.addEventListener("submit", (e) => { e.preventDefault(); send(input.value); });
  input.addEventListener("input", autosize);
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey && !e.isComposing) { e.preventDefault(); send(input.value); }
  });
  input.addEventListener("paste", (e) => {
    const files = Array.from(e.clipboardData?.files ?? []);
    if (files.length) { e.preventDefault(); addFiles(files); }
  });
  fileInput.addEventListener("change", () => { if (fileInput.files) addFiles(fileInput.files); fileInput.value = ""; });
  panel.addEventListener("dragover", (e) => { e.preventDefault(); panel.classList.add("is-drop"); });
  panel.addEventListener("dragleave", () => panel.classList.remove("is-drop"));
  panel.addEventListener("drop", (e) => {
    e.preventDefault();
    panel.classList.remove("is-drop");
    if (e.dataTransfer?.files.length) addFiles(e.dataTransfer.files);
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) open(false); });
  // Links inside the panel navigate the site; on phones the panel would cover the new page.
  log.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest("a");
    if (a && matchMedia("(max-width: 639px)").matches && a.getAttribute("href")?.startsWith("/")) open(false);
  });
  // Any page can open Huba: <a href="#huba"> or window.dispatchEvent(new Event("huba:open")).
  window.addEventListener("huba:open", () => open(true));
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest('a[href="#huba"]');
    if (a) { e.preventDefault(); open(true); }
  });

  // Only offer Huba when the server has a model key.
  fetch("/api/huba/status").then((r) => r.json()).then((s) => { if (s.enabled) root.classList.add("is-ready"); }).catch(() => undefined);
</script>

<style>
  .huba { display: none; }
  .huba.is-ready { display: block; }

  .huba-launch {
    position: fixed; right: 1rem; bottom: calc(var(--mobile-cta-h) + 0.75rem); z-index: 55;
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.7rem; border-radius: 999px;
    background: var(--color-ink); color: var(--color-paper);
    box-shadow: var(--shadow-card);
    transition: background var(--dur-fast) var(--ease-out-soft), transform var(--dur-fast) var(--ease-out-soft);
  }
  .huba-launch:hover { background: var(--color-charcoal); }
  .huba-launch:focus-visible { outline: 2px solid var(--color-brass); outline-offset: 3px; }
  .huba-door { width: 1.75rem; height: 1.75rem; color: var(--color-brass); }
  .huba-launch-label { display: none; font-size: var(--text-sm); letter-spacing: var(--tracking-mid); padding-right: 0.4rem; }
  .huba.is-open .huba-launch { display: none; }
  @media (min-width: 720px) {
    .huba-launch { right: 1.5rem; bottom: 1.5rem; padding: 0.65rem 1rem 0.65rem 0.75rem; }
    .huba-launch-label { display: inline; }
  }

  .huba-panel {
    position: fixed; inset: 0; z-index: 70;
    display: flex; flex-direction: column;
    background: var(--color-paper); color: var(--color-ink);
  }
  .huba-panel[hidden] { display: none; }
  .huba-panel.is-drop { outline: 2px dashed var(--color-brass); outline-offset: -8px; }
  @media (min-width: 640px) {
    .huba-panel {
      inset: auto 1.5rem 1.5rem auto;
      width: min(26rem, calc(100vw - 3rem));
      height: min(40rem, calc(100dvh - 3rem));
      border: 1px solid var(--color-cream);
      box-shadow: var(--shadow-card);
    }
  }
  :global(html.huba-lock), :global(html.huba-lock body) { overflow: hidden; }

  .huba-head {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.85rem 1rem; background: var(--color-ink); color: var(--color-paper);
  }
  .huba-id { display: flex; align-items: center; gap: 0.7rem; min-width: 0; flex-wrap: wrap; }
  .huba-avatar {
    width: 2.2rem; height: 2.2rem; flex: none; border-radius: 999px;
    display: grid; place-items: center; border: 1px solid var(--color-brass); color: var(--color-brass);
  }
  .huba-avatar svg { width: 1.3rem; height: 1.3rem; }
  .huba-name { font-family: var(--font-serif); font-size: 1.35rem; line-height: 1; }
  .huba-sub { font-size: var(--text-xs); color: var(--color-mist); letter-spacing: var(--tracking-mid); }
  .huba-badge {
    font-size: 0.65rem; letter-spacing: var(--tracking-wide); text-transform: uppercase;
    border: 1px solid var(--color-brass); color: var(--color-brass); padding: 0.15rem 0.45rem;
  }
  .huba-badge[hidden] { display: none; }
  .huba-actions { display: flex; align-items: center; gap: 0.25rem; flex: none; }
  .huba-done {
    font-size: var(--text-sm); padding: 0.35rem 0.75rem; border: 1px solid var(--color-stone); color: var(--color-paper);
    transition: border-color var(--dur-fast);
  }
  .huba-done:hover { border-color: var(--color-brass); }
  .huba-done[hidden] { display: none; }
  .huba-x { width: 2.25rem; height: 2.25rem; display: grid; place-items: center; color: var(--color-paper); }
  .huba-x svg { width: 1.15rem; height: 1.15rem; }

  .huba-log { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; overscroll-behavior: contain; }
  .huba-log :global(.huba-msg) { max-width: 88%; font-size: 0.95rem; line-height: 1.5; padding: 0.65rem 0.85rem; }
  .huba-log :global(.huba-msg p + p),
  .huba-log :global(.huba-msg p + ul), .huba-log :global(.huba-msg p + ol),
  .huba-log :global(.huba-msg ul + p), .huba-log :global(.huba-msg ol + p) { margin-top: 0.5rem; }
  .huba-log :global(.huba-msg ul) { list-style: disc; padding-left: 1.2rem; }
  .huba-log :global(.huba-msg ol) { list-style: decimal; padding-left: 1.2rem; }
  .huba-log :global(.huba-msg a) { color: var(--color-brass-deep); text-decoration: underline; text-underline-offset: 2px; }
  .huba-log :global(.huba-assistant) { align-self: flex-start; background: var(--color-canvas); border: 1px solid var(--color-cream); }
  .huba-log :global(.huba-user) { align-self: flex-end; background: var(--color-ink); color: var(--color-paper); }
  .huba-log :global(.huba-att) { font-size: var(--text-xs); opacity: 0.8; margin-top: 0.35rem; }
  .huba-log :global(.huba-img) { display: block; margin: 0.5rem 0; }
  .huba-log :global(.huba-img img) { display: block; max-width: 100%; max-height: 18rem; border: 1px solid var(--color-cream); }
  .huba-log :global(.huba-chips) { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .huba-log :global(.huba-chips button) {
    font-size: var(--text-sm); padding: 0.4rem 0.7rem; border: 1px solid var(--color-brass); color: var(--color-brass-deep);
    background: transparent; transition: background var(--dur-fast);
  }
  .huba-log :global(.huba-chips button:hover) { background: var(--color-cream); }
  .huba-log :global(.huba-thinking span) {
    display: inline-block; width: 0.4rem; height: 0.4rem; margin-right: 0.25rem; border-radius: 999px;
    background: var(--color-stone); animation: huba-dot 1.2s infinite var(--ease-out-soft);
