---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import TrustStrip from "../components/TrustStrip.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ProductCard from "../components/ProductCard.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import SocialProof from "../components/SocialProof.astro";
import SpecCompareTable from "../components/SpecCompareTable.astro";
import LockBrandWall from "../components/LockBrandWall.astro";
import ServiceArea from "../components/ServiceArea.astro";
import FAQ from "../components/FAQ.astro";
import ContactCTA from "../components/ContactCTA.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Stat from "../components/Stat.astro";
import { SITE, SLA } from "../data/site";

const products = [
  {
    family: "stilus" as const,
    name: "Korhű biztonsági ajtó",
    priceFrom: "Egyedi árajánlat",
    classBadge: "Műemléki",
    bullets: [
      "Kazettás, betétes vagy festett kivitelben",
      "Az eredeti ajtó alapján rekonstruálva",
      "Egyedi tervezés az elfogadott engedélyezési terv alapján",
    ],
    image: "/assets/photos/hero/period-yellow.jpg",
    imageAlt: "Korhű biztonsági ajtó polgári lakásban",
    href: "/stilus-biztonsagi-ajto",
  },
  {
    family: "modern" as const,
    name: "Modern Standard",
    priceFrom: "440 000 Ft-tól",
    classBadge: "MABISZ 2.",
    bullets: [
      "Hőhídmentes acél zártszelvényből készült tok",
      "Kőzetgyapot hő és hangszigetelés, körbefutó tömítés",
      "35 fa minta és 15 mart minta közül választható",
    ],
    image: "/assets/photos/hero/modern-white.jpg",
    imageAlt: "Modern fehér biztonsági ajtó",
    href: "/biztonsagi-ajto",
  },
  {
    family: "modern" as const,
    name: "Prémium családi ház",
    priceFrom: "600 000 Ft-tól",
    classBadge: "RC3 / MABISZ 3.",
    bullets: [
      "Új építésű és felújított házakhoz",
      "9+ záródási pont, prémium cilinderrel",
      "Építészeti minőségű kivitelben",
    ],
    image: "/assets/photos/hero/modern-anthracite.jpg",
    imageAlt: "Prémium modern bejárati ajtó családi házban",
    href: "/biztonsagi-ajto/premium",
  },
];

const testimonials = [
  {
    quote: "A felmérőtök fél óra alatt értette, mire van szükség a lépcsőházunk stílusához illeszkedő ajtóhoz. Precíz, gyors munka volt elejétől a végéig.",
    name: "Dr. Kovács Á.",
    district: "Budapest, V. kerület",
    product: "Korhű biztonsági ajtó · 2024",
  },
  {
    quote: "Modern panelra is a saját műhelyetekben gyártott ajtót kaptuk — nem importáruda. A különbség 10 év múlva is látszik majd.",
    name: "Szabó M.",
    district: "Budapest, XV. kerület",
    product: "Huba Modern Standard · 2023",
  },
  {
    quote: "Egy hét alatt felmérés, három hét alatt beépítés egy mogyoródi új építésű családi házba. Ablakcsere is ugyanazon a felmérésen.",
    name: "Nagy Cs.",
    district: "Mogyoród",
    product: "Premium családi ház + ACTUAL csomag · 2025",
  },
];

const faqItems = [
  { q: "Mennyibe kerül egy biztonsági ajtó?",
    a: `<p>A modern modelleink belépőszintje <strong>440 000 Ft</strong>, a prémium kivitel <strong>600 000 Ft-tól</strong> indul. A korhű és műemléki ajtókat egyedi árazással készítjük. A végleges árat a helyszíni felmérés után tudjuk megadni. <a href="/arak">Részletes árlista →</a></p>` },
  { q: "Mennyi idő, mire elkészül és beépítjük?",
    a: `<p>Modern ajtónál ${SLA.surveyDays} a helyszíni felmérés, ${SLA.manufactureDays} a gyártás, és ${SLA.installDays} a beépítés. Műemléki környezetben az örökségvédelmi engedélyezési eljárással együtt a teljes folyamat jellemzően ${SLA.permitTotal} — az engedélyezést az Ön építésze vagy örökségvédelmi szakértője intézi.</p>` },
  { q: "Műemléki vagy védett épületbe is építenek ajtót?",
    a: `<p>Igen. Az eredeti ajtó alapján rekonstruált, korhű, kazettás vagy festett kivitelt készítünk — az engedélyezéshez szükséges műszaki dokumentációt (méretrajz, anyagminta) is biztosítjuk az Ön építésze vagy örökségvédelmi szakértője számára. <a href="/muemleki-biztonsagi-ajto">Műemléki biztonsági ajtó →</a></p>` },
  { q: "Mi a különbség a betörésvédelmi osztályok (RC2–RC6) között?",
    a: `<p>Az osztály azt mutatja, hogy az ajtónak mennyi ideig kell ellenállnia egy szakszerű betörési kísérletnek: RC2 — 3 perc, RC3 — 5 perc, RC4 — 10 perc, RC5 — 15 perc, RC6 — 20 perc. Lakásba általában RC2–RC3-at, magas kockázatú helyre RC4–RC5-öt ajánlunk.</p>` },
  { q: "Mit fedez a 15 éves szerkezeti garancia?",
    a: `<p>Az acél tokra és az ajtószárny szerkezetére 15 év teljes körű garanciát adunk. A zárszerkezetre 18 hónap, a teljes biztonsági ajtóra 1 év garancia jár. <a href="/garancia">Részletes garancia →</a></p>` },
  { q: "Milyen zárakat építenek be?",
    a: `<p>Mottura, Abus, Mul-T-Lock, Iseo és Cisa zárak közül a helyszíni felmérés után választhat. Mindegyik prémium európai gyártó — márkás cilinderekkel, és évek múlva is rendelhető pótalkatrésszel.</p>` },
  { q: "Miben jobb egy Huba ajtó, mint egy 150 000 Ft-os katalógusajtó?",
    a: `<p>Vékony hajlított lemez helyett zártszelvényből készült acél tok, megerősített zárlemez, MABISZ 2.–5. osztály közül szabadon választható kivitel, márkás európai zárszerkezet, 15 év szerkezeti garancia, és tíz év múlva is rendelhető pótalkatrész. <a href="#miben-tobb">Részletes összehasonlítás →</a></p>` },
  { q: "Lehet részletfizetés?",
    a: `<p>Igen — Cofidis áruhitellel, az aktuális kampányoktól függően akár 0%-os THM mellett. Reprezentatív példa: 440 000 Ft / 10 hó ≈ 44 000 Ft / hó. <a href="/reszletfizetes">Részletfizetés →</a></p>` },
];
---
<BaseLayout
  title={`${SITE.brand} — Stílus, műemléki és modern biztonsági ajtó saját gyártásból`}
  description={`Korhű, kazettás biztonsági ajtótól a modern panellakásig — saját gyártás Kistarcsán. MABISZ-minősített ${SITE.mabiszSince} óta, ${SITE.warrantyYears} év szerkezeti garancia, ${SITE.priceFromHUF.toLocaleString("hu-HU")} Ft-tól. Ingyenes helyszíni felmérés Budapesten és Pest megyében.`}
>
  <Hero
    eyebrow={`Saját gyártás Kistarcsán · ${SITE.founded} óta`}
    heading="Századfordulós lakástól<br/>a modern családi házig.<br/><em>Egy gyártótól.</em>"
    lead="Minden ajtót a Kistarcsai műhelyünkben készítünk — műemléki környezetbe korhű kivitelben, modern lakásokba acél biztonsági szerkezettel. Mindegyikre MABISZ-minősítés és 15 év szerkezeti garancia jár."
    pillars={[
      "Saját gyártás",
      `MABISZ ${SITE.mabiszSince} óta`,
      "Műemléki környezetben is",
      `${SITE.warrantyYears} év garancia`,
      `${SITE.priceFromHUF.toLocaleString("hu-HU")} Ft-tól`,
    ]}
    image="/assets/photos/hero/period-yellow.jpg"
    imageAlt="Korhű, kovácsoltvas rácsokkal díszített biztonsági ajtó egy budapesti polgári lakásban"
    imageCaption="Budapest, I. kerület · 2024"
  />

  <div id="below"></div>
  <TrustStrip />

  <Section
    tone="paper"
    eyebrow="Vélemények"
    heading="Magyar tulajdonosoktól, magyar otthonokban."
    lead="Több mint húsz éve dolgozunk budapesti és Pest megyei otthonokon — a műemléki belvárostól az agglomeráció prémium családi házaiig."
  >
    <SocialProof
      rating={{ value: 4.8, count: 127, source: "Google" }}
      testimonials={testimonials}
    />
  </Section>

  <Section
    tone="cream"
    eyebrow="Termékcsaládok"
    heading="A teljes kínálat — egyetlen acél szerkezetre építve."
    lead="A klasszikus stílusú és a modern ajtók ugyanarra a MABISZ-minősített acél szerkezetre épülnek. A különbség a látható borításban van, és abban, hogy szükséges-e hozzá örökségvédelmi engedélyezési eljárás."
  >
    <div class="product-grid stagger">
      {products.map(p => <ProductCard {...p} />)}
    </div>
    <p class="product-note">
      Minden Huba ajtó ugyanazt az acél biztonsági szerkezetet kapja — csak a látható borítás és a kivitelezés különbözik.
    </p>
  </Section>

  <Section
    tone="paper"
    eyebrow="Előtte / utána"
    heading="Egy ajtócsere, ami az egész lépcsőházat átalakítja."
    lead="Megkopott vasajtótól vagy elavult acélajtótól a korhű, mégis modern biztonságot adó új ajtóig — ugyanaz a nyílás, más évszázad."
  >
    <BeforeAfterSlider
      before="/assets/photos/hero/before-old-door.jpg"
      after="/assets/photos/hero/period-yellow.jpg"
      caption="Budapest, V. kerület — 1928-as polgári ház, az eredeti ajtó alapján rekonstruálva."
    />
  </Section>

  <Section
    tone="paper"
    eyebrow="Hogyan dolgozunk"
    heading="Egy felmérés. Négy lépés. Tizenkét nap."
    lead="A modern ajtóknál a megkereséstől a beépítésig 12 nap. Műemléki engedélyezéssel 4–6 hónap, lépésről lépésre."
  >
    <ProcessSteps />
  </Section>

  <section id="muemleki-ajtok" class="ec-section">
    <div class="container">
      <header class="ec-section-header reveal">
        <p class="eyebrow">
          <span class="tricolor-strip" aria-hidden="true"><span></span><span></span><span></span></span>
          Műemléki és stílus ajtók
        </p>
        <h2 class="ec-section-heading">Korhű biztonsági ajtó — az eredeti alapján rekonstruálva.</h2>
        <p class="ec-section-lead">
          Műemléki vagy helyi védettségű házaknál a nyílászárócserét külön örökségvédelmi engedélyezési
          eljárás előzi meg, amelyet az Ön építésze vagy örökségvédelmi szakértője intéz a hatóságnál.
          Mi a jóváhagyott terv alapján gyártjuk le a korhű, kazettás vagy festett biztonsági ajtót —
          a szükséges méretrajzot és anyagmintát is biztosítjuk.
        </p>
      </header>
      <div class="ec-section-cta reveal">
        <a href="/muemleki-biztonsagi-ajto" class="btn btn-primary btn-large">Műemléki biztonsági ajtó →</a>
        <a href="/felmeres" class="btn btn-ghost btn-large">Kérjen ingyenes felmérést</a>
      </div>
    </div>
  </section>

  <Section
    tone="ink"
    eyebrow="Miben több ennyivel"
    heading="Mire fizet rá egy katalógusajtónál — és mire nem."
    lead="Tényekre alapozott összehasonlítás. Sem országot, sem konkrét márkát nem említünk — csak mérhető tulajdonságokat."
  >
    <div id="miben-tobb">
      <SpecCompareTable />
    </div>
  </Section>

  <Section
    tone="paper"
    eyebrow="Saját gyártás · Kistarcsa"
    heading="A műhely, ahol az Ön ajtaja készül."
    lead={`2143 Kistarcsa, Nagytarcsai út 6. Itt vágjuk az acél zártszelvényt, itt hegesztjük a tokot, itt készítjük a kazettás faburkolatot. ${SITE.founded} óta — három generáció ugyanazon a címen.`}
  >
    <div class="workshop-grid">
      <figure class="workshop-figure reveal">
        <img src="/assets/photos/hero/workshop.jpg" alt="A Huba ajtó műhelye Kistarcsán" loading="lazy" />
      </figure>
      <div class="workshop-stats stagger">
        <Stat value={`${new Date().getFullYear() - SITE.founded}+`} label="év dokumentált beépítés" sub={`${SITE.founded} óta`} />
        <Stat value="50+" label="fa és mart mintázat" sub="alapáron választható" />
        <Stat value="5" label="prémium zármárka" sub="Mottura · Abus · Mul-T-Lock · Iseo · Cisa" />
        <Stat value={`${SITE.warrantyYears}`} label="év szerkezeti garancia" sub="a piac leghosszabb vállalása" />
      </div>
    </div>
    <LockBrandWall />
  </Section>

  <Section
    tone="cream"
    eyebrow="Szolgáltatási terület"
    heading="Belvárostól az agglomerációig — ahova el is jutunk."
    lead="A műemléki belvárosi munkáktól a Pest megyei prémium családi házakig. Kistarcsáról 30 perc alatt a helyszínen vagyunk."
  >
    <ServiceArea />
  </Section>

  <Section
    tone="paper"
    eyebrow="GYIK"
    heading="A leggyakoribb kérdések."
    lead="A felmérés előtt jellemzően ezek merülnek fel. Ha nem találja a választ, hívjon minket bizalommal."
  >
    <FAQ items={faqItems} />
  </Section>

  <ContactCTA />
  <CookieBanner />
</BaseLayout>

<style>
  .product-grid {
    display: grid; grid-template-columns: 1fr; gap: 1.5rem;
  }
  @media (min-width: 700px) { .product-grid { grid-template-columns: repeat(3, 1fr); } }
  .product-note {
    margin-top: 2rem; font-style: italic; color: var(--color-charcoal);
    text-align: center; max-width: 60ch; margin-inline: auto;
  }

  .ec-section { padding-block: clamp(4rem, 7vw, 6.5rem); background: var(--color-paper); }
  .ec-section-header { max-width: 56rem; margin-bottom: 3rem; }
  .ec-section-heading { font-family: var(--font-serif); font-size: var(--text-h2); line-height: 1.05; letter-spacing: -0.015em; max-width: 28ch; margin-top: 1rem; }
  .ec-section-lead { font-family: var(--font-serif); font-size: var(--text-lead); line-height: 1.5; color: var(--color-charcoal); max-width: 56ch; margin-top: 1.25rem; }
  .ec-section-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.5rem; }

  .workshop-grid {
    display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; margin-bottom: 3rem;
  }
  @media (min-width: 900px) { .workshop-grid { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }
  .workshop-figure { margin: 0; aspect-ratio: 4/3; background: var(--color-cream); }
  .workshop-figure img { width: 100%; height: 100%; object-fit: cover; }
  .workshop-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
</style>
