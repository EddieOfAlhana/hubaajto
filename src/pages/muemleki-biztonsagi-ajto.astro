const testimonials = [
  {
    quote:
      "Az engedélyt magunk intéztük, közel négy hónapig tartott — de a Huba ajtaja pontosan a jóváhagyott terv szerint készült, a hatóság a záró szemlén elsőre elfogadta.",
    name: "Dr. Veres E.",
    district: "Budapest, I. kerület (Várnegyed)",
    product: "Korhű műemléki kivitel · 2024",
  },
  {
    quote:
      "TKR 1/2022 §53 alapján a lépcsőházi ajtót csak TKBE után cserélhettem. A saját építészünk vitte végig a bejelentést, a Huba pedig pontosan a jóváhagyott terv szerint gyártotta és építette be az ajtót.",
    name: "Bárdos M.",
    district: "Budapest, VIII. kerület",
    product: "Stílus Premium · 2023",
  },
  {
    quote:
      "Az építészünk vitte a Tervtanácsra a Huba műhelyfotóit és anyagmintáit — ez sokat segített, az engedély 5 hét alatt megvolt. A beépített ajtó pontosan az elfogadott terv szerint készült.",
    name: "Hercz F.",
    district: "Budapest, V. kerület",
    product: "Korhű rekonstrukció · 2025",
  },
];

const faqItems = [
  {
    q: "Honnan tudom, hogy az ingatlanom műemlék vagy védett?",
    a: `<p>Helyrajzi szám alapján lekérdezhető az <a href="https://www.oeny.hu/oeny/veding/" target="_blank" rel="noopener">OÉNY védettségi nyilvántartásból</a>. Az adatbázis ingyenesen elérhető, a válasz jellemzően egy napon belül megvan. Érdemes ezt a tervezés legelső lépéseként, még a felmérés előtt ellenőriznie — vagy megkérdeznie építészét.</p>`,
  },
  {
    q: "Mindenképpen el kell utasítani a modern biztonsági ajtót?",
    a: `<p>A 68/2018. (IV. 9.) Korm. rendelet 53. §-a alapján a védett vagy nevesített elem megjelenését megváltoztató ajtócsere <strong>engedélyköteles vagy bejelentésköteles</strong>. A katalógus-modern megjelenésű ajtó stílusilag és anyaghasználatban nem felel meg — ezért nem építhető be. A Huba korhű kivitel viszont igen: kívülről fa, kazettás vagy betétes, belül acélbetétes szerkezettel.</p>`,
  },
  {
    q: "Mennyibe kerül a korhű ajtó?",
    a: `<p>A korhű Huba ajtó ára jellemzően <strong>700 000 – 2 500 000 Ft</strong> között alakul — a kivitel bonyolultságától (kazettázás, kovácsoltvas díszítés, üvegezés) függően, egyedi árajánlat alapján. Ehhez jön a beépítés, jellemzően 80–250 e Ft. Az örökségvédelmi engedélyeztetés (állapotfelmérés, építész terv, építéstörténeti dokumentáció) ettől független, piaci áron elérhető szolgáltatás, amit saját építésze vagy a hatóság névjegyzékében szereplő szakértő végez — ezt a Huba nem nyújtja. A hatósági illeték maga 0 Ft (illetékmentes). <a href="/arak">Teljes árlista →</a></p>`,
  },
  {
    q: "Mennyi időbe telik?",
    a: `<p>Az örökségvédelmi engedélyezés hatósági átfutása eljárástípustól függ: az ÉTDR-eljárás önmagában 25 nap, de a felméréssel, tervezéssel, esetleges tervtanácsi véleményezéssel és hiánypótlással együtt a gyakorlatban jellemzően 4–6 hónapra nyúlik — ezt érdemes saját ügyintézőjénél vagy építészénél előre egyeztetnie. A Huba a jóváhagyott terv birtokában ${SLA.manufactureDays} alatt gyártja le az ajtót, a beépítés ${SLA.installDays}.</p>`,
  },
  {
    q: "Mit kockáztatok, ha engedély nélkül cseréltetem?",
    a: `<p>Az örökségvédelmi bírság a beruházási érték <strong>10–50%-a</strong> (191/2001. Korm. rendelet). Településkép-védelmi bírság (kerületi TKBE elmulasztása) 200 000–2 000 000 Ft. Súlyosabb esetben a hatóság elrendelheti az <strong>eredeti állapot helyreállítását</strong>. Egy 1 milliós ajtó 100–500 e Ft bírsággal és az ajtó visszabontásával is végződhet.</p>`,
  },
  {
    q: "Az acélbetét nem rontja a műemléki értéket?",
    a: `<p>A hatóság elfogadja, ha a látható felület korhű (fa, eredeti osztás, eredeti vasalat) — a belső acélszerkezet rejtett. „Acélbetétes biztonsági szerkezet a fa-felületű korhű megjelenés alatt” — ezt a megfogalmazást érdemes az engedélykérelemben is feltüntetni. A 4. §-ban a Kötv. nem tiltja a belső szerkezeti megerősítést, csak a műemléki érték érvényesülését óvja.</p>`,
  },
  {
    q: "Közös képviselő hozzájárulása szükséges?",
    a: `<p>Igen, társasházi környezetben a Ptk. és a Társasházi törvény alapján a közös képviselő (vagy közgyűlés) hozzájárulása szükséges. Kérésre anyagmintákkal és fotókkal segítjük az Ön vagy építésze prezentációját a közgyűlésen vagy a kerületi főépítésznél — magát az egyeztetést és a hozzájárulás megszerzését azonban Önnek vagy megbízott szakértőjének kell intéznie.</p>`,
  },
  {
    q: "Mi a különbség engedély és bejelentés között?",
    a: `<p>Az <strong>engedély</strong> az örökségvédelmi hatóság aktív, érdemi döntése — 25 napos határidővel. A <strong>bejelentés</strong> 10 napos jogszerű hallgatással záruló eljárás: ha a hatóság hallgat, az tudomásulvételnek minősül. A két eljárás közötti különbség a védettségi szintből következik, amelyet az OÉNY-nyilvántartásból vagy a kerületi főépítésznél tudhat meg.</p>`,
  },
];
---

<BaseLayout
  title="Műemléki biztonsági ajtó — korhű kivitelben | Huba ajtó"
  description="Műemlék vagy védett épületben él? Általános biztonsági ajtó nem építhető be — a Huba korhű, az örökségvédelmi elvárásoknak megfelelő kivitelt gyárt, acél belső szerkezettel. Egyedi árajánlat, Budapest belváros + budai műemléki környezet."
>
  <Hero
    eyebrow="Műemléki termékcsalád · korhű kivitelben"
    heading="Műemlék vagy védett épületben él?<br/><em>Mi készítjük az illeszkedő ajtót.</em>"
    lead="Általános biztonsági ajtó nem építhető be — a hatóság elutasítja. A Huba korhű kivitelét acél belső szerkezettel a budapesti Kormányhivatal Építésügyi és Örökségvédelmi Főosztály engedélyezési gyakorlatában elfogadták. A szükséges örökségvédelmi engedélyt Önnek vagy megbízott építészének kell beszereznie — mi a hatóság elvárásainak megfelelő ajtót gyártjuk és építjük be."
    pillars={[
      "Korhű, engedélyezhető kivitel",
      "700 000 Ft-tól — egyedi árajánlat",
      `${SLA.manufactureDays} gyártás`,
      `MABISZ ${SITE.mabiszSince} óta`,
      `${SITE.warrantyYears} év szerkezeti garancia`,
    ]}
    image="/assets/photos/hero/period-mustard-double.jpg"
    imageAlt="Mustársárga kétszárnyú, boltíves korhű biztonsági ajtó kovácsoltvas díszrácsos üvegezéssel"
    imageCaption="Egyedi íves kivitel · kovácsoltvas díszrácsos üvegezéssel"
    primaryCta={{ label: "Ingyenes helyszíni felmérés kérése", href: "/felmeres" }}
    secondaryCta={{ label: "Árak és kivitelek", href: "/arak" }}
  />

  <div id="below"></div>
  <TrustStrip />

  <Section
    tone="paper"
    eyebrow="A piaci hézag"
    heading="A katalógusajtó-piac itt nem ad megoldást."
    lead="A budapesti belvárosi és budai műemléki környezet lakásállomány nagyobbik fele védett — műemlék, nyilvántartott érték, helyi védettség vagy műemléki környezet. Az általános biztonsági ajtó-gyártók erre a piacra nem tudnak ajánlatot adni. A 15 versenytárs egyikénél sem találtuk meg a műemléki kapacitás kifejezést — pedig a vevő itt áll, és a saját pénzével nem boldogul."
  >
    <div class="trapped-market reveal">
      <p class="trapped-quote">
        „Az engedélyt magunk intéztük, közel négy hónapig tartott — de a Huba ajtaja
        pontosan a jóváhagyott terv szerint készült, a hatóság elsőre elfogadta.”
      </p>
      <p class="trapped-cite">— Dr. Veres E., Budapest I. kerület, Várnegyed (2024)</p>
    </div>
  </Section>

  <Section
    tone="cream"
    eyebrow="A védettségi szintek"
    heading="A „védett” épület nem egy fogalom — hat szint létezik."
    lead="Ezt érdemes elsőként tisztázni, mert ez dönti el, mely hatóságot kell felkeresni és milyen eljárással. A védettségi szint egy munkanap alatt ellenőrizhető OÉNY-lekérdezéssel — ezzel érdemes a tervezést kezdeni, még a felmérés előtt."
  >
    <div class="protection-grid stagger">
      {
        protectionLevels.map((p) => (
          <article class="protection">
            <h3>{p.label}</h3>
            <p>{p.desc}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section
    tone="paper"
    eyebrow="Mit készítünk pontosan"
    heading="Acél belső szerkezet, korhű külső megjelenés."
    lead="A hatóság elfogadja, ha a látható felület korhű — a belső biztonsági szerkezet rejtett. Ez a Huba ajtó / Szer-X3 fő terméke."
  >
    <div class="what-we-make">
      <div class="wwm-block reveal">
        <h3>A belső acél szerkezet</h3>
        <ul>
          <li>Hőhídmentes acél zártszelvény tok — méretre szabva, nem hajlított lemez</li>
          <li>Megerősített acéllap a zárszerkezetek körül</li>
          <li>Kőzetgyapot bélelés — hő- és hangszigetelés</li>
          <li>Több ponton — felül, alul és hátul is záródó kivitel</li>
          <li>MABISZ 2.–5. osztály választható (10–15 perc áttörés elleni védelem)</li>
          <li>Mottura · Abus · Mul-T-Lock · Iseo · Cisa zárak</li>
        </ul>
      </div>

      <div class="wwm-block reveal">
        <h3>A korhű külső megjelenés</h3>
        <ul>
          <li>Tömör tölgy, vörösfenyő vagy lucfenyő — az eredeti faanyag szerint</li>
          <li>Hagyományos lapolt csapozásos kötés</li>
          <li>Eredeti kazettás vagy betétes osztás, eredeti profilszélesség</li>
          <li>Lenolaj-alapú vagy szelektív lakk — RAL 6009 / 8014 / 5008</li>
          <li>Sárgaréz vagy kovácsoltvas vasalat (pánt, sarokvas, fogantyú, levélbedobó)</li>
          <li>Igény szerint ólmozott, metszett, homokfúvott üveg</li>
        </ul>
      </div>
    </div>
  </Section>

  <Section
    tone="cream"
    eyebrow="Az engedélyezési folyamat"
    heading="Amit érdemes tudnia az engedélyeztetésről."
    lead="A védett vagy műemléki épület ajtócseréje jellemzően engedélyköteles vagy bejelentésköteles eljárás. Ezt Önnek vagy megbízott építészének kell lefolytatnia a Kormányhivatal Építésügyi és Örökségvédelmi Főosztályán, illetve a kerületi főépítésznél — a Huba ezt a szolgáltatást nem nyújtja. A gyártott ajtó ugyanakkor a jóváhagyott tervnek és a hatósági elvárásoknak megfelelően készül."
  >
    <div class="permit-info reveal">
      <ol class="permit-steps">
        <li>Védettségi szint ellenőrzése (OÉNY-nyilvántartás)</li>
        <li>Állapotfelmérés és építész terv készítése</li>
        <li>Építéstörténeti dokumentáció, ha a védettségi szint megkívánja</li>
        <li>Kérelem benyújtása (ÉTDR) vagy bejelentés a hatóságnál</li>
        <li>Tervtanácsi vélemény, egyes kerületekben kötelező</li>
        <li>Az engedély vagy hozzájárulás birtokában: a Huba ajtó gyártása és beépítése</li>
        <li>Befejezési bejelentés a hatóság felé</li>
      </ol>
      <p class="permit-note">
        Ezekben a lépésekben saját építésze vagy a hatóság szakértői névjegyzékében
        szereplő szakember tud eljárni. A Huba szerepe a folyamat végén kezdődik: a
        jóváhagyott terv alapján gyártjuk le és építjük be a korhű ajtót.
      </p>
    </div>
  </Section>

  <Section
    tone="paper"
    eyebrow="Tipikus elutasítási okok"
    heading="A 7 hiba, ami miatt a hatóság visszadob egy kérelmet."
    lead="A 68/2018. Korm. rendelet 53. §-a szerint a kérelmet elutasítják, ha a tervezett tevékenység szakszerűtlen, vagy a műemlék jellegét sértő módon megváltoztatja. A leggyakoribb okok — amikre felkészülünk."
  >
    <div class="rejections stagger">
      {
        rejectionReasons.map((r) => (
          <article class="rejection">
            <span class="rejection-n">{r.n}</span>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section
    tone="ink"
    eyebrow="Tapasztalat számokban"
  >
    <div class="stats-grid stagger">
      <Stat
        value="200+"
        label="korhű kivitelű ajtó referencia"
        sub="Budapest belvárosi kerületekben"
      />
      <Stat value={SLA.manufactureDays} label="gyártási idő" sub="a jóváhagyott terv alapján" />
      <Stat value="0 Ft" label="hatósági illeték" sub="örökségvédelmi engedélyezés illetékmentes" />
      <Stat value={`${SITE.warrantyYears} év`} label="szerkezeti garancia" sub="minden korhű kivitelre" />
    </div>
  </Section>

  <Section
    tone="paper"
    eyebrow="Budapesti kerületek"
    heading="Ahol védett vagy műemléki környezetben dolgozunk."
    lead="A budapesti kerületek mindegyike saját településképvédelmi rendelettel (TKR) és saját kerületi építési szabályzattal (KÉSZ) szabályozza a nyílászáró-cserét. Alább a leggyakoribb kerületspecifikus tudnivalók, amelyeket érdemes ismernie, mielőtt nekivág az engedélyeztetésnek."
  >
    <div class="districts stagger">
      {
        districts.map((d) => (
          <article class="district">
